[?1049h[22;0;0t[24;1H[?1h=// Command greet prints a greeting for each name it is given.
package main

import (
        "fmt"
        "os"
        "strings"
)

// greeting is the line greet prints for name.
func greeting(name string) string {
        if name == "" {
                return "Hello, world!"
        }
        return fmt.Sprintf("Hello, %s!", strings.TrimSpace(name))
}

func main() {
        names := os.Args[1:]
        if len(names) == 0 {
                fmt.Println(greeting(""))
                return
        }
[7mmain.go[27m[K[K        for _, name := range names {
                fmt.Println(greeting(name))
        }
}

// count is how many of names are not empty.
func count(names []string) int {
        n := 0
        for _, name := range names {
                if name != "" {
                        n++
                }
        }
        return n
}
